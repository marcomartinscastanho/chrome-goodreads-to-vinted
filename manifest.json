{
  "manifest_version": 3,
  "name": "Goodreads to Vinted",
  "version": "1.1.0",
  "description": "Adds English and Portuguese Vinted search links to Goodreads book lists.",
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.goodreads.com/review/list/*"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [],
  "host_permissions": ["https://www.vinted.pt/*"]
}
